{
  "name": "mml-bookmark",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mml-bookmark/app dev",
    "build": "pnpm --filter @mml-bookmark/app build",
    "start": "pnpm --filter @mml-bookmark/app start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migration:create": "pnpm --filter @mml-bookmark/db migration:create",
    "db:migration:up": "pnpm --filter @mml-bookmark/db migration:up",
    "db:migration:down": "pnpm --filter @mml-bookmark/db migration:down",
    "db:migration:list": "pnpm --filter @mml-bookmark/db migration:list"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
