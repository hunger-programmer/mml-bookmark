# Copy to .env (root). Read by packages/app (Next) and packages/db (MikroORM CLI).
# Local values come from the Supabase CLI stack: `pnpm supabase:start`, then `pnpm exec supabase status -o env`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_DEBUG=false

# Supabase Auth, server-side only (never NEXT_PUBLIC_). Locally: API_URL and PUBLISHABLE_KEY from `supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
